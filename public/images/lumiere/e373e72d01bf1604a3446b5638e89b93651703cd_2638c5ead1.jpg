/* To keep a shortcut icon in a fixed position on the screen while the page scrolls */
@media (min-width: 1024px) {
.shortcut-icon {
  position: fixed;
  top: 50%;                /* Position at the middle of the viewport */
  right: 20px;             /* Distance from the right edge */
  transform: translateY(-50%);  /* Offset by half its own height to perfectly center */
  z-index: 1000;
}
}

@media (max-width: 1100px) {
  /* 隐藏所有 class 包含 "shortcut" 的元素，或直接隐藏特定图片 */
  img[alt*="Shortcut"],
